<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ambient Shadow Under the Logo -->
    <path
        android:pathData="M43,33 L74,54 L43,75 Z"
        android:strokeWidth="12"
        android:strokeColor="#50000000"
        android:strokeLineJoin="round"
        android:fillColor="#50000000" />

    <!-- Outer Cinematic Wave Arc (Left flowing ribbon) -->
    <path
        android:pathData="M35,32 C35,28 39,26 42,28 L52,35 C50,42 46,50 46,54 C46,58 50,66 52,73 L42,80 C39,82 35,80 35,76 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="35"
                android:startY="28"
                android:endX="52"
                android:endY="80"
                android:type="linear">
                <item android:color="#FF0A84FF" android:offset="0.0" />
                <item android:color="#FF00468D" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Main Dynamic Play Glyph (Azure to Ice Cyan Gradient) -->
    <path
        android:pathData="M44,32 C44,28.5 47.8,26.3 50.8,28.1 L77.5,50.1 C80.2,51.8 80.2,56.2 77.5,57.9 L50.8,79.9 C47.8,81.7 44,79.5 44,76.0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="44"
                android:startY="28"
                android:endX="80"
                android:endY="78"
                android:type="linear">
                <item android:color="#FF64D2FF" android:offset="0.0" />
                <item android:color="#FF0A84FF" android:offset="0.65" />
                <item android:color="#FF005DB8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Specular Highlight Sheen on Upper Facet -->
    <path
        android:pathData="M45,34 L75,54 L55,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="45"
                android:startY="34"
                android:endX="75"
                android:endY="54"
                android:type="linear">
                <item android:color="#70FFFFFF" android:offset="0.0" />
                <item android:color="#10FFFFFF" android:offset="0.7" />
                <item android:color="#00FFFFFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Internal Radiant Core Crest (Glowing Wave Crest) -->
    <path
        android:pathData="M51,43 L65,54 L51,65 Z"
        android:fillColor="#FFFFFFFF" />

    <!-- Micro Star / Sparkle Point at Vertex -->
    <path
        android:pathData="M65,54m-2,0a2,2 0 1,1 4,0a2,2 0 1,1 -4,0"
        android:fillColor="#FFFFFFFF" />

</vector>